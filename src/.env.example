# -----------------------------------------------------------------------------
# Variables de entorno (opcionales)
# El modelo no requiere credenciales ni claves: toda su configuración se pasa
# por línea de comandos o se lee de runs/exp1/config.json. Estas variables las
# reconoce PyTorch directamente y sirven para ajustar el entorno de ejecución.
# Copie este archivo como .env, ajuste los valores y cárguelo con:
#   set -a; source .env; set +a
# -----------------------------------------------------------------------------

# GPU que se usará (descomentar para elegir una; -1 = forzar CPU)
# CUDA_VISIBLE_DEVICES=0

# Carpeta donde PyTorch guarda los pesos preentrenados de ImageNet
TORCH_HOME=~/.cache/torch

# En Mac con Apple Silicon: usar CPU para operaciones que MPS no soporte
PYTORCH_ENABLE_MPS_FALLBACK=1
